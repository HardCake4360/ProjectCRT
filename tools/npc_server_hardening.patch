+"""Ordered conversation memory for one running NPC server process."""
+import json
+import os
+import tempfile
+import threading
+import time
+
+
+class ConversationMemory:
+    def __init__(self, directory):
+        self.directory = directory
+        self._lock = threading.RLock()
+        self._revisions = {}
+
+    @staticmethod
+    def scope(persona):
+        return (persona or "assistant").strip() or "assistant"
+
+    def log_path(self, user):
+        return os.path.join(self.directory, f"{(user or 'anonymous').strip() or 'anonymous'}.jsonl")
+
+    def summary_path(self, user, persona):
+        user = (user or "anonymous").strip() or "anonymous"
+        return os.path.join(self.directory, f"{user}__{self.scope(persona)}.summary.json")
+
+    def _key(self, user, persona):
+        return (os.path.abspath(self.log_path(user)), self.scope(persona))
+
+    def _bump(self, user, persona):
+        key = self._key(user, persona)
+        self._revisions[key] = self._revisions.get(key, 0) + 1
+
+    def append(self, user, persona, speaker, text):
+        with self._lock:
+            record = {"ts": time.time(), "speaker": speaker, "text": text, "personaKey": self.scope(persona)}
+            with open(self.log_path(user), "a", encoding="utf-8") as stream:
+                stream.write(json.dumps(record, ensure_ascii=False) + "\n")
+            self._bump(user, persona)
+
+    def read(self, user, persona, max_items=200):
+        with self._lock:
+            path = self.log_path(user)
+            if not os.path.exists(path):
+                return []
+            records = []
+            with open(path, encoding="utf-8") as stream:
+                for line in stream:
+                    try:
+                        record = json.loads(line)
+                    except (ValueError, TypeError):
+                        continue
+                    if record.get("personaKey", "").strip() == self.scope(persona):
+                        records.append(record)
+            return records[-max_items:]
+
+    def snapshot(self, user, persona, max_items=60):
+        with self._lock:
+            return self._revisions.get(self._key(user, persona), 0), self.read(user, persona, max_items)
+
+    def _atomic_write(self, path, content):
+        temporary = None
+        try:
+            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=self.directory, delete=False) as stream:
+                temporary = stream.name
+                stream.write(content)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temporary, path)
+        finally:
+            if temporary and os.path.exists(temporary):
+                os.remove(temporary)
+
+    def write_summary(self, user, persona, summary, expected_revision=None):
+        with self._lock:
+            if expected_revision is not None and expected_revision != self._revisions.get(self._key(user, persona), 0):
+                return False
+            self._atomic_write(self.summary_path(user, persona), json.dumps(summary, ensure_ascii=False))
+            return True
+
+    def read_summary(self, user, persona):
+        with self._lock:
+            try:
+                with open(self.summary_path(user, persona), encoding="utf-8") as stream:
+                    return json.load(stream)
+            except (OSError, ValueError):
+                return None
+
+    def reset(self, user, persona):
+        with self._lock:
+            self._bump(user, persona)
+            path = self.log_path(user)
+            if os.path.exists(path):
+                kept = []
+                with open(path, encoding="utf-8") as stream:
+                    for line in stream:
+                        try:
+                            record = json.loads(line)
+                        except (ValueError, TypeError):
+                            continue
+                        if record.get("personaKey", "").strip() != self.scope(persona):
+                            kept.append(record)
+                self._atomic_write(path, "".join(json.dumps(record, ensure_ascii=False) + "\n" for record in kept))
+            summary = self.summary_path(user, persona)
+            if os.path.exists(summary):
+                os.remove(summary)
