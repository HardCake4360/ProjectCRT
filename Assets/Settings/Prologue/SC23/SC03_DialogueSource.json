{
  "lines": [
    {
      "camera": 2,
      "speaker": "jeremy",
      "text": "어서 오세요! 혼자 오셨나요?"
    },
    {
      "camera": 2,
      "speaker": "san",
      "text": "네. 혹시 레베카라는 분 계십니까?"
    },
    {
      "camera": 2,
      "speaker": "jeremy",
      "text": "아, 점장님이요? 잠깐 안쪽에 계신데. 불러드릴까요?"
    },
    {
      "camera": 2,
      "speaker": "san",
      "text": "아뇨, 급한 건 아닙니다. 잠깐 기다리죠."
    },
    {
      "camera": 2,
      "speaker": "jeremy",
      "text": "그러시면 여기 앉아서 기다리세요."
    },
    {
      "camera": 3,
      "speaker": "jeremy",
      "text": "처음 뵙는 분 같은데, 점장님하고 아는 사이세요?"
    },
    {
      "camera": 3,
      "speaker": "san",
      "text": "네. 오래된 친구입니다."
    },
    {
      "camera": 3,
      "speaker": "jeremy",
      "text": "아, 그러셨구나."
    },
    {
      "camera": 3,
      "speaker": "san",
      "text": "여기서 일한 지는 오래됐나요?"
    },
    {
      "camera": 3,
      "speaker": "jeremy",
      "text": "아뇨. 그렇게 오래되지는 않았어요. 그래도 이제 웬만한 일은 혼자 할 수 있습니다."
    },
    {
      "camera": 3,
      "speaker": "san",
      "text": "그렇군요. 꽤 능숙해 보이네요."
    },
    {
      "camera": 3,
      "speaker": "jeremy",
      "text": "하하, 감사합니다."
    },
    {
      "camera": 4,
      "speaker": "rebecca",
      "text": "제레미, 아까 부탁한 건……."
    },
    {
      "camera": 4,
      "speaker": "rebecca",
      "text": "……산?"
    },
    {
      "camera": 5,
      "speaker": "san",
      "text": "오랜만이야, 레베카."
    },
    {
      "camera": 5,
      "speaker": "rebecca",
      "text": "네가 여긴 웬일이야?"
    },
    {
      "camera": 5,
      "speaker": "san",
      "text": "이 근처로 이사 왔거든. 인사나 할 겸 들렀지."
    },
    {
      "camera": 5,
      "speaker": "rebecca",
      "text": "미리 연락이라도 하지 그랬어."
    },
    {
      "camera": 5,
      "speaker": "san",
      "text": "갑자기 생각나서. 방금 짐 정리 끝내고 오는 길이야."
    },
    {
      "camera": 5,
      "speaker": "rebecca",
      "text": "참 너답네."
    },
    {
      "camera": 6,
      "speaker": "jeremy",
      "text": "두 분 정말 아는 사이셨네요."
    },
    {
      "camera": 6,
      "speaker": "rebecca",
      "text": "응. 꽤 오래된 친구야."
    },
    {
      "camera": 6,
      "speaker": "rebecca",
      "text": "인사는 했어? 얘는 제레미. 여기서 나랑 같이 일하고 있어."
    },
    {
      "camera": 6,
      "speaker": "jeremy",
      "text": "제레미라고 합니다. 잘 부탁드립니다."
    },
    {
      "camera": 6,
      "speaker": "san",
      "text": "산입니다. 저야말로 잘 부탁해요."
    },
    {
      "camera": 6,
      "speaker": "rebecca",
      "text": "제레미, 카운터는 내가 볼 테니까 홀 좀 부탁할게."
    },
    {
      "camera": 6,
      "speaker": "jeremy",
      "text": "네, 점장님. 그럼 두 분 편히 이야기 나누세요."
    },
    {
      "camera": 6,
      "speaker": "rebecca",
      "text": "그래서, 이사 왔다고?"
    },
    {
      "camera": 6,
      "speaker": "san",
      "text": "응. 이번에 LSPD로 전출됐어."
    },
    {
      "camera": 6,
      "speaker": "rebecca",
      "text": "……하필 여기로?"
    },
    {
      "camera": 6,
      "speaker": "san",
      "text": "나도 그렇게 생각해."
    },
    {
      "camera": 6,
      "speaker": "rebecca",
      "text": "뭐, 어쨌든 잘 왔어."
    },
    {
      "camera": 6,
      "speaker": "rebecca",
      "text": "한잔할래?"
    },
    {
      "camera": 6,
      "speaker": "san",
      "text": "그러려고 왔지."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "……그래서, 결국 어떻게 됐는데?"
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "뭐, 결국 네 말대로 됐지."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "그럴 줄 알았어."
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "그럴 거면 처음부터 좀 더 강하게 말려주지 그랬어."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "말린다고 들었을 것 같아?"
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "……아니."
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "그나저나 네가 바를 운영하고 있을 줄은 몰랐어."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "왜, 안 어울려?"
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "그런 건 아니고. 조금 의외라서."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "나도 처음엔 그랬어. 지금은 익숙해졌지만."
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "그래도 가게는 꽤 괜찮은데? 분위기도 좋고."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "칭찬 고맙네."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "한 잔 더 줄까?"
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "아니, 아직 괜찮아."
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "아까 그 친구도 꽤 싹싹하더라."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "제레미?"
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "응. 어린 나이에 제법 일도 잘하는 것 같고."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "맞아. 성실한 애야. 가끔은 너무 성실해서 탈이지만."
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "그래?"
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "뭐든 자기가 알아서 하려고 하거든. 조금은 남한테 맡겨도 될 텐데."
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "좋은 직원 뒀네."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "그렇지."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "덕분에 나도 많이 편해졌어."
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "잘 지내는 것 같아서 다행이네."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "너도 이제 여기서 잘 지내야지."
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "그러게. 일단 적응부터 해야겠지만."
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "너라면 잘할 거야."
    },
    {
      "camera": 7,
      "speaker": "san",
      "text": "그렇게 생각해?"
    },
    {
      "camera": 7,
      "speaker": "rebecca",
      "text": "적어도 내가 아는 너는 그랬으니까."
    },
    {
      "camera": 8,
      "speaker": "rebecca",
      "text": "……?"
    },
    {
      "camera": 8,
      "speaker": "rebecca",
      "text": "제레미?"
    },
    {
      "camera": 8,
      "speaker": "san",
      "text": "무슨 소리야?"
    },
    {
      "camera": 8,
      "speaker": "rebecca",
      "text": "글쎄……."
    },
    {
      "camera": 8,
      "speaker": "rebecca",
      "text": "제레미! 안에 있어?"
    },
    {
      "camera": 8,
      "speaker": "san",
      "text": "제레미가 안쪽에 있나?"
    },
    {
      "camera": 8,
      "speaker": "rebecca",
      "text": "응. 아까 안쪽 정리하러 갔는데 아직 안 돌아왔네."
    },
    {
      "camera": 8,
      "speaker": "rebecca",
      "text": "……뭐 하고 있는 거지."
    },
    {
      "camera": 9,
      "speaker": "rebecca",
      "text": "잠깐 확인하고 올게."
    },
    {
      "camera": 9,
      "speaker": "san",
      "text": "같이 가자."
    },
    {
      "camera": 9,
      "speaker": "rebecca",
      "text": "……그래."
    },
    {
      "camera": 10,
      "speaker": "rebecca",
      "text": "제레미?"
    },
    {
      "camera": 12,
      "speaker": "rebecca",
      "text": "……제레미?"
    }
  ]
}